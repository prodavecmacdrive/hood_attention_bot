# Получите API_ID и API_HASH на https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Номер телефона в международном формате
PHONE=+1234567890

# Каналы для мониторинга (через запятую, с @ или без)
CHANNELS=@channel1,@channel2,@channel3

# Ключевые слова для поиска (через запятую)
KEYWORDS=bitcoin,crypto,ethereum

# Целевой канал для репоста (должны быть права администратора)
TARGET_CHANNEL=@your_channel
