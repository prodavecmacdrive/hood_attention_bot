# Telegram API credentials from https://my.telegram.org
# 1. Go to https://my.telegram.org
# 2. Login with your phone number
# 3. Go to "API Development Tools"
# 4. Create an application
# 5. Copy api_id and api_hash
API_ID=12345678
API_HASH=your_api_hash_here

# Your phone number in international format (with +)
PHONE=+380991234567

# Bot token from @BotFather
# 1. Open Telegram and find @BotFather
# 2. Send /newbot command
# 3. Follow instructions
# 4. Copy the token
BOT_TOKEN=123456789:AAEexample_your_bot_token_here

# Channels to monitor (comma-separated, with @)
# Example: @kharkiv_now,@trivoga_kh,@kharkov_news
CHANNELS=@channel1,@channel2,@channel3

# Keywords for filtering (comma-separated, lowercase recommended)
# Example: шахед,рсзо,ракета,обстрел,тревога
KEYWORDS=keyword1,keyword2,keyword3

# Target channel for repost (you must be admin there)
# Example: @my_alert_channel
TARGET_CHANNEL=@your_channel
