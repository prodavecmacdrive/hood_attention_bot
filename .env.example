# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Phone number in international format
PHONE=+1234567890

# Bot token for management (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Optional: Database URL for cloud deployment (e.g., PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Optional: Session string for cloud deployment (instead of session files)
# SESSION_STRING=your_session_string_here

# Channels to monitor (comma-separated, with @ or without)
CHANNELS=@channel1,@channel2,@channel3

# Keywords for search (comma-separated)
KEYWORDS=bitcoin,crypto,ethereum

# Target channel for repost (must have admin rights)
TARGET_CHANNEL=@your_channel
