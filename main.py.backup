            buttons=get_main_menu()
        )

# === ОБРАБОТЧИК СООБЩЕНИЙ ===

@client.on(events.NewMessage())
async def message_handler(event):
    """Обработчик новых сообщений из отслеживаемых каналов"""
    # Пропускаем личные сообщения (это команды)
    if event.is_private:
        return
    
    # Проверяем, что сообщение из отслеживаемого канала
    channels = db.get_channels()
    chat_username = f"@{event.chat.username}" if event.chat.username else None
    
    if not chat_username or chat_username not in channels:
        return
    
    try:
        message_text = event.message.text
        
        if not message_text:
            return
            
        message_lower = message_text.lower()
        keyword_groups = db.get_keywords()
        
        # Проверка на наличие ключевых слов
        matched_groups = []
        
        for group in keyword_groups:
            # Разделяем группу на отдельные слова
            words = [w.strip() for w in group.split(',')]
            
            # Проверяем: если это группа (AND), то все слова должны быть в сообщении
            if len(words) > 1:
                # AND - все слова должны быть
                if all(word in message_lower for word in words):
                    matched_groups.append(group)
            else:
                # Одно слово
                if words[0] in message_lower:
                    matched_groups.append(group)
        
        if matched_groups:
            logger.info(f"Найдено совпадение: {matched_groups}")
            logger.info(f"Канал: {chat_username}")
            
            target_channel = db.get_target_channel()
            
            # Пересылаем (forward) сообщение в целевой канал
            await client.forward_messages(
                target_channel,
                event.message
            )
            
            logger.info(f"Сообщение переслано в {target_channel}")
            
    except Exception as e:
        logger.error(f"Ошибка обработки сообщения: {e}")


async def main():
    """Запуск бота"""
    global ADMIN_ID
    
    logger.info("Запуск бота...")
    
    # Проверка конфигурации
    if not API_ID or not API_HASH or not PHONE:
        logger.error("Ошибка: не заданы API_ID, API_HASH или PHONE в файле .env")
        return
    
    await client.start(phone=PHONE)
    
    # Получаем ID администратора (вас)
    me = await client.get_me()
    ADMIN_ID = me.id
    logger.info(f"Авторизован как: {me.first_name} (ID: {ADMIN_ID})")
    
    # Инициализация БД из .env при первом запуске
    if not db.get_channels() and CHANNELS:
        logger.info("Импорт начальных каналов из .env...")
        for channel in CHANNELS:
            db.add_channel(channel)
    
    if not db.get_keywords() and KEYWORDS:
        logger.info("Импорт начальных ключевых слов из .env...")
        for keyword in KEYWORDS:
            db.add_keyword(keyword)
    
    if TARGET_CHANNEL:
        db.set_target_channel(TARGET_CHANNEL)
    
    # Получаем текущие настройки из БД
    channels = db.get_channels()
    keywords = db.get_keywords()
    target = db.get_target_channel()
    
    if not channels:
        logger.warning("⚠️ Нет каналов для мониторинга. Добавьте каналы через /add_channel")
    
    if not keywords:
        logger.warning("⚠️ Нет ключевых слов. Добавьте слова через /add_keyword")
    
    logger.info("Бот успешно запущен!")
    logger.info(f"📺 Отслеживаемые каналы ({len(channels)}): {channels}")
    logger.info(f"🔑 Ключевые слова ({len(keywords)}): {keywords}")
    logger.info(f"🎯 Целевой канал: {target}")
    logger.info("💬 Используйте команды в личных сообщениях с ботом для управления")
    logger.info("Ожидание новых сообщений...")
    
    await client.run_until_disconnected()


if __name__ == '__main__':
    client.loop.run_until_complete(main())
